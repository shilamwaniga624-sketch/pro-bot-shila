function updateDashboard(signal, confidence) {

    document.getElementById("totalTicks").innerHTML =
        digitHistory.length;

    const count = new Array(10).fill(0);

    digitHistory.forEach(d => count[d]++);

    let most = 0;
    let least = 0;

    for (let i = 1; i < 10; i++) {

        if (count[i] > count[most]) most = i;

        if (count[i] < count[least]) least = i;

    }

    document.getElementById("mostDigit").innerHTML = most;
    document.getElementById("leastDigit").innerHTML = least;

    document.getElementById("currentSignal").innerHTML =
        signal;

    document.getElementById("signalStrength").innerHTML =
        confidence + "%";

    const history =
        document.getElementById("signalHistory");

    const time =
        new Date().toLocaleTimeString();

    history.innerHTML =
        "<div style='padding:6px;border-bottom:1px solid #222'>" +
        time +
        " | " +
        volatility.value +
        " | " +
        signal +
        " | Confidence " +
        confidence +
        "%" +
        "</div>" +
        history.innerHTML;

}

